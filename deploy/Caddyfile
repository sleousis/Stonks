# Caddy in front of `stonks serve` (Phase 14.2, 12.8).
#
# STONKS_DOMAIN decides where the certificate comes from:
#   stonks.example.com         -> Let's Encrypt (public mode, ports 80/443 open)
#   stonks.tailnet-x.ts.net    -> the host's Tailscale daemon (private mode)
#   localhost                  -> Caddy's internal CA (local testing)

# No ACME email is needed: Let's Encrypt accounts work without one.

{$STONKS_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The console's policy (src/stonks/api/csp.py). The app sets it on its own
		# responses, and the API docs get a looser one there. "?" fills it in only
		# where a response has none, such as Caddy's own error pages.
		?Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-KC3V0qVKo5qInDk2JVN6KUjFYu6/nAE0F9WvsYC53lI=' 'sha256-+Jb5+AxvkmTR/x608Q8JrS09X3c611QZi4RY1bOFuAA='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	reverse_proxy api:8000 {
		# The request keeps its real Host (Caddy's default). The API's
		# trusted-host check accepts loopback names plus [api].allowed_hosts,
		# which Compose sets from STONKS_DOMAIN (STONKS_API_ALLOWED_HOSTS), so
		# a request for any other name is refused there too.
		# Job event streams (SSE) must not be buffered.
		flush_interval -1
	}

	# JSON access log. A browser EventSource sends the short-lived job
	# stream token as ?token=, so the logged URI carries it redacted.
	# Caddy already leaves Cookie and Authorization out of the log.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}
}
