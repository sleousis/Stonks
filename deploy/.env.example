# Stonks server settings. Copy to deploy/.env on the VM and fill in:
#   cp .env.example .env && chmod 600 .env
# Placeholders only. Never commit the real .env (deploy/.gitignore blocks it).
# Compose reads this file for ${...} values AND passes it to the app containers.
# Backup secrets go in backup.env instead (backup.env.example).

# ---- Stack -------------------------------------------------------------------
# Image and tag. deploy.sh rewrites STONKS_IMAGE_TAG on every deploy.
STONKS_IMAGE=ghcr.io/OWNER/stonks
STONKS_IMAGE_TAG=v1.0.0
# Private mode (Tailscale): add the Tailscale override. Public mode: delete the line.
COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
# Runs the scheduler worker (python -m stonks.scheduling, Phase 12.2). Leave
# empty while the image has no scheduler; use cron from docs/operations.md then.
# Add ",lab-worker" to run heavy lab jobs in their own container (14.9), and
# set STONKS_LAB_EXECUTOR=worker below so the API queues them for it.
# Other profiles: ibkr-paper, ibkr-live (IB Gateway, deploy/ibkr/README.md),
# ai (model server), backup (restic, one-shot). See docs/deploy.md, Profiles.
COMPOSE_PROFILES=scheduler
# Lab offload (docs/deploy.md). in_process: lab jobs run inside the API.
# STONKS_LAB_EXECUTOR=worker
# STONKS_LAB_WORKER_CPUS=2
# STONKS_LAB_WORKER_MEMORY=3g
# Hostname Caddy serves. Tailscale: <machine>.<tailnet>.ts.net. Public: stonks.example.com
# The API answers this name only (plus "api" inside Compose): compose.yaml
# passes it as STONKS_API_ALLOWED_HOSTS, and the API refuses any other Host.
STONKS_DOMAIN=stonks.your-tailnet.ts.net
# Bind Caddy to one address (e.g. the server's Tailscale 100.x IP). Default: all.
# STONKS_BIND_IP=100.64.0.1
# Host folder behind the `data` volume (on the attached block volume).
STONKS_DATA_PATH=/srv/stonks/data

# Docker network of the stack. The API trusts X-Forwarded-For only from it
# (Caddy). Change it only if it clashes with a network on the host.
# STONKS_DOCKER_SUBNET=172.31.250.0/24

# ---- App secrets (read by stonks) -----------------------------------------------
# Master keys for second-factor secrets and broker credentials. Needed for
# sign-in. Generate: docker compose run --rm api python -m stonks.security keygen
STONKS_SECRET_KEYS=
# Old shared token (acts as the bootstrap admin, going away). The scheduler
# still uses it to call the API. Generate: openssl rand -hex 32
# It signs in as the admin, so never leave a guessable value here: deploy.sh
# refuses to run while it is "change-me".
STONKS_API_TOKEN=
EODHD_API_KEY=
# Broker keys, only when [brokers] kind = "alpaca" (paper keys first).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# ---- Interactive Brokers (deploy/ibkr/README.md) -----------------------------
# The IBKR username and password go in deploy/ibkr/secrets/*.txt, never here.
# "yes" makes the gateway refuse every order (read-only soak). Default no.
IBKR_READ_ONLY_API=
# Gateway clock time zone. Default America/New_York.
IBKR_TIME_ZONE=
# Daily gateway restart, "hh:mm AM/PM" in IBKR_TIME_ZONE. Default 11:45 PM.
IBKR_AUTO_RESTART_TIME=
# Memory limit per gateway container. Default 1g.
# IBKR_GATEWAY_MEMORY=1g
# Optional Flex Web Service token for daily statements. Read by Stonks only.
STONKS_IBKR_FLEX_TOKEN=

# ---- AI assistant (profile ai) -------------------------------------------------
# OpenAI-compatible endpoint. The bundled model server: http://model-server:11434/v1
STONKS_AI_BASE_URL=
# Memory limit of the model server. Default 8g.
# STONKS_AI_MEMORY=8g
# Key of the assistant's model endpoint, only when it needs one. The bundled
# model server and local Ollama, vLLM or llama.cpp usually need none.
STONKS_ASSISTANT_API_KEY=

# ---- Telegram (optional, docs/operations.md) ----------------------------------
# Bot token from @BotFather. Sends alerts to linked chats, and the bot answers
# commands when [telegram].enabled = true. Env only, never TOML.
STONKS_TELEGRAM_BOT_TOKEN=

# Chat webhook for alerts (Slack, Discord, Mattermost, ...).
STONKS_NOTIFY_WEBHOOK_URL=
STONKS_LOG_LEVEL=INFO

# ---- Off-server backups --------------------------------------------------------
# The restic password, the bucket keys and the backup and host ping URLs go
# in deploy/backup.env (copy backup.env.example), never here. This file goes
# to every app container, and a compromised app must not reach the backups.

# ---- Monitoring (healthchecks.io or Uptime Kuma push URLs) --------------------
# Each job pings its URL on success and <URL>/fail on failure. Empty = off.
# HC_PING_BACKUP, HC_PING_RESTORE_TEST and HC_PING_HOST live in backup.env.
# The default ingest_prices, tick and health jobs ping these (their ping_url_env).
HC_PING_INGEST=
HC_PING_TICK=
HC_PING_HEALTH=
# Host alert limits (deploy/monitor/check-host.sh), in percent.
ALERT_DISK_PCT=80
ALERT_MEM_PCT=90
ALERT_LOAD_PCT=90
