# Backup and host-check secrets. Copy to deploy/backup.env on the server:
#   cp backup.env.example backup.env && chmod 600 backup.env
# Placeholders only. Never commit the real backup.env (deploy/.gitignore
# blocks it).
#
# Only the restic container and the host scripts (backup.sh, restore.sh,
# restore-test.sh, check-host.sh) read this file. The app containers (api,
# scheduler, lab-worker) never get it, so a compromised app cannot read or
# delete the off-server backups. Upgrading from a single .env? Run
# deploy/scripts/migrate-backup-env.sh (docs/deploy.md).

# ---- Off-server backups (restic, deploy/backup/) ------------------------------
# Backblaze B2 or Cloudflare R2 through the S3 API.
#   B2: s3:https://s3.<region>.backblazeb2.com/<bucket>/stonks
#   R2: s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>/stonks
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/your-bucket/stonks
# Encryption password for the repository. Keep a copy OFF the server.
# Generate: openssl rand -base64 32. restic refuses an empty one, and
# backup.sh warns on every run while it is the old placeholder "change-me".
RESTIC_PASSWORD=
# Bucket key, limited to this bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 only:
# AWS_DEFAULT_REGION=auto
# Only for restic's native B2 backend (RESTIC_REPOSITORY=b2:<bucket>:stonks):
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# ---- Monitoring (healthchecks.io or Uptime Kuma push URLs) --------------------
# Each job pings its URL on success and <URL>/fail on failure. Empty = off.
# The app's own pings (HC_PING_INGEST, HC_PING_TICK, HC_PING_HEALTH) stay
# in .env: the scheduler sends them.
HC_PING_BACKUP=
HC_PING_RESTORE_TEST=
HC_PING_HOST=
