{
  "name": "stonks-console",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/preload-routes.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint && node --test scripts/check-copy.test.mjs scripts/preload-routes.test.mjs && node scripts/check-copy.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.{json,ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "api:generate": "openapi-ts && node scripts/gen-permissions.mjs",
    "api:check": "node scripts/check-generated.mjs"
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "lightweight-charts": "5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
