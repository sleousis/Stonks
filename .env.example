# EODHD credentials. Free tier supports EOD prices only; fundamentals require a paid plan.
# Sign up at https://eodhd.com
EODHD_API_KEY=

# Alpaca trading API keys (use PAPER account keys from https://app.alpaca.markets).
# Optional: only read when [brokers] kind = "alpaca" (opt-in; the default
# "simulated" broker needs no keys). The paper endpoint is the default.
# Env only: setting them in config/*.toml is rejected.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Interactive Brokers (docs/design/live-trading.md, deploy/ibkr/README.md).
# The IBKR username and password are NOT set here: they go in Docker secret
# files under deploy/ibkr/secrets/, read by the gateway container only.
# Gateway knobs for deploy/compose.yaml (empty = the Compose default):
# "yes" makes the gateway refuse every order (a read-only soak). Default no.
IBKR_READ_ONLY_API=
# Time zone of the gateway's clock. Default America/New_York.
IBKR_TIME_ZONE=
# Daily gateway restart, "hh:mm AM/PM" in IBKR_TIME_ZONE. Default 11:45 PM.
IBKR_AUTO_RESTART_TIME=
# Optional Flex Web Service token for daily statements. Read by Stonks only.
STONKS_IBKR_FLEX_TOKEN=

# AI assistant model endpoint (OpenAI-compatible). With the Compose `ai`
# profile: http://model-server:11434/v1
STONKS_AI_BASE_URL=

# Master keys that seal second-factor secrets and broker credentials at rest.
# Needed before anyone can sign in with a password. Generate one with
#   uv run python -m stonks.security keygen
# Format: <key id>:<base64 key>, newest first, comma-separated when rotating.
# STONKS_SECRET_KEYS=

# Old shared API token. It acts as the bootstrap admin and is going away:
# create a personal token (stk_...) in the web app instead. Leave empty unless
# an old script still needs it. Generate: openssl rand -hex 32
# STONKS_API_TOKEN=

# Your personal API token for `stonks mcp` (stk_...). Every MCP tool then acts
# as you, with that token's scopes. Wins over STONKS_API_TOKEN.
# STONKS_MCP_TOKEN=

# Local UI work only: reads from 127.0.0.1 need no sign-in. Never on a server.
# STONKS_PROFILE=dev

# Override paths / logging if you need to
STONKS_DATA_DIR=./data
STONKS_LOG_LEVEL=INFO

# Set to 1 to enable live-API integration tests (tests/integration/live/*)
# STONKS_RUN_LIVE_TESTS=1
