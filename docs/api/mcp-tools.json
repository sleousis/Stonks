{
  "instructions": "Stonks research + trading system. Tools talk to the local REST API started\nwith `stonks serve`. Read tools are safe. Job tools queue backtests, lab runs\nand ingests; follow up with wait_for_job. Status changes and production ticks\nneed confirm=true; call them first without it to get a preview and show it to\nthe user before confirming. run_tick is a dry run unless dry_run=false, and a\nreal tick is refused unless the API reports a paper/simulated broker. No tool\ncan change broker settings or enable live trading.",
  "resource_templates": [],
  "resources": [
    {
      "description": "Cash, total value and positions of the current portfolio",
      "mime_type": "application/json",
      "name": "portfolio_summary",
      "uri": "stonks://portfolio/summary"
    }
  ],
  "server": "stonks",
