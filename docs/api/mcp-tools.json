            "title": "Interval",
            "type": "string"
          },
          "objective": {
            "default": "sharpe",
            "enum": [
              "sharpe",
              "cagr",
              "final_return"
            ],
            "title": "Objective",
            "type": "string"
          },
          "register_strategy": {
            "default": false,
            "description": "register the tuned strategy (lands in shadow status)",
            "title": "Register Strategy",
            "type": "boolean"
          },
          "seed": {
            "default": 0,
            "title": "Seed",
            "type": "integer"
          },
          "start": {
