            "format": "date",
            "title": "Start",
            "type": "string"
          },
          "survival_tests": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "oos",
                    "period_stability",
                    "perturbation",
                    "drift",
                    "runs_test",
                    "permutation"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "survival suite; server default when omitted",
            "title": "Survival Tests"
          },
          "train_ratio": {
            "default": 0.7,
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
